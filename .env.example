# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# The server reads these at startup. Nothing here is secret; AI_GATEWAY_API_KEY is.

# Vercel AI Gateway key, used as `Authorization: Bearer <key>` when calling jev.
# Create one at https://vercel.com/dashboard -> AI Gateway -> API Keys.
# Leave it unset to run the board in demo mode, which serves deterministic local
# verdicts instead of calling the gateway. The UI labels demo verdicts as such.
AI_GATEWAY_API_KEY=

# Evaluation model. Any AI Gateway model with the Evaluation capability works.
JEV_MODEL=typesafe-ai/jev

# Gateway origin. Override to point at a stub during testing.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# Address the board's HTTP server binds to.
LIVE_JUDGE_ADDR=127.0.0.1:8787

# Built frontend to serve at `/`. Produced by `vp build` in web/.
# Unset or missing means API-only; use the Vite dev server for the UI.
WEB_DIST=web/dist

# Timeout for a single gateway call.
JEV_TIMEOUT_MS=15000

# tracing-subscriber filter.
RUST_LOG=live_judge_server=info,tower_http=warn
